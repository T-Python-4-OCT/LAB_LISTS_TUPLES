""" Movie Ratings Analysis Calculates average movie ratings """



movies = [
    ("prison_break",2005,[9,3,8]),
    ("Breaking_Bad",2008,[9,10,7]),
    ("Professor",2019,[8,6,9]),
    ("Fear", 2023, [8, 2, 3,]),
    ("Inception", 2010, [9, 8, 9]),
    ("Interstellar", 2014, [10, 9, 9]),
    ]
        
for movie in movies:
    title, year, ratings = movie
    average = sum(ratings)/ len(ratings)
    
    
    if average >=6.0:
        print(f"{title} ({year}) -Avergae rating: {average:.2f} ★") 
         



